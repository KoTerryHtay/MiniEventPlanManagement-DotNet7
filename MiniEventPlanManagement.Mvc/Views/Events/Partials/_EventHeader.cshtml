@using MiniEventPlanManagement.Domain.Models.Dto
@model EventDto

<div class="px-6 py-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <!-- Event Title & Date -->
    <div class="space-y-1">
        <h2 class="text-2xl font-bold text-slate-800 tracking-tight">@Model.Name</h2>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-slate-500">
            <span class="inline-flex items-center gap-1.5">
                <i class="fa-regular fa-calendar text-indigo-500"></i>
                @Model.EventDate.ToString("MMMM dd, yyyy hh:mm tt")
            </span>
            <span class="hidden sm:inline text-slate-300">|</span>
            <span class="inline-flex items-center gap-1.5">
                <i class="fa-regular fa-clock text-slate-400"></i>
                Created: @Model.CreatedDate.ToString("MMMM dd, yyyy hh:mm tt")
            </span>
        </div>
    </div>

    <!-- Optional: Status Badge or Quick Action Placeholder -->
    <div class="flex-shrink-0">
        @{
            var isUpcoming = Model.EventDate > DateTime.Now;
            var statusClass = isUpcoming 
                ? "bg-emerald-50 text-emerald-700 border-emerald-200" 
                : "bg-slate-100 text-slate-600 border-slate-200";
            var statusLabel = isUpcoming ? "Upcoming" : "Past";
        }
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold border @statusClass">
            <i class="fa-solid fa-circle text-[6px] mr-1.5 @(isUpcoming ? "text-emerald-500" : "text-slate-400")"></i>
            @statusLabel
        </span>
    </div>
</div>