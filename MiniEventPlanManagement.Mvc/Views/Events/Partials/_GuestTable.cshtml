<!-- Table Selection & Actions -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div id="tablesContainer">
        <button type="button" class="btn btn-outline-primary m-1 table-btn active"
                data-table-id="all"
                data-table-name="All Guests">
            All Guests
        </button>
        <!-- Dynamic table buttons will be appended here -->
    </div>
    <div>
        <button id="btnAssignGuest" type="button" class="btn btn-primary me-2"
                data-bs-toggle="modal"
                data-bs-target="#assignGuestModal"
                style="display: none;">
            + Assign Guest to this Table
        </button>
        <button type="button" class="btn btn-success"
                data-bs-toggle="modal"
                data-bs-target="#createGuestModal">
            + Add Guest
        </button>
    </div>
</div>

<!-- Guest List Table -->
<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>No.</th>
                <th>Name</th>
                <th>Phone</th>
                <th>RSVP Status</th>
                <th class="text-center">Check-In</th>
                <th class="text-center">Checked In At</th>
            </tr>
        </thead>
        <tbody id="guestTableBody">
            <tr><td colspan="6" class="text-center text-muted py-4">No guests found.</td></tr>
        </tbody>
    </table>
</div>

<!-- Create Guest Modal -->
<div class="modal fade" id="createGuestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Guest</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label for="newGuestName" class="form-label">Full Name</label>
                <input type="text" id="newGuestName" class="form-control" placeholder="Enter guest name" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="btnSaveGuest" class="btn btn-primary">Save Guest</button>
            </div>
        </div>
    </div>
</div>

<!-- Assign Guest Modal -->
<div class="modal fade" id="assignGuestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Assign Guest to Table</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label for="guestSelectDropdown" class="form-label">Search and Select Guest</label>
                <select id="guestSelectDropdown" class="form-select" style="width: 100%;">
                    <option value="">-- Loading... --</option>
                </select>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="btnAssignGuestSave" class="btn btn-primary">Assign</button>
            </div>
        </div>
    </div>
</div>