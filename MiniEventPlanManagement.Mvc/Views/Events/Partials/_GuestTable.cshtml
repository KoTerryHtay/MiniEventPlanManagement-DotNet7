<!-- Guest Table Section -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 id="guestListTitle" class="mb-0">All Guests</h4>
    <div>
        <button type="button" class="btn btn-primary btn-sm" id="btnAssignGuest" style="display: none;">
            + Assign Guest to this Table
        </button>
        <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#createGuestModal">
            + Add Guest
        </button>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>No.</th>
                <th>Name</th>
                <th>Phone</th>
                <th>RSVP Status</th>
                <th>Check-In</th>
                <th>Checked In At</th>
            </tr>
        </thead>
        <tbody id="guestTableBody">
            <!-- Rows will be rendered by JS -->
        </tbody>
    </table>
</div>

<!-- Create Guest Modal -->
<div class="modal fade" id="createGuestModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Guest</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input type="text" class="form-control" id="newGuestName" placeholder="Enter guest name">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnSaveGuest">Save Guest</button>
            </div>
        </div>
    </div>
</div>

<!-- Assign Guest Modal -->
<div class="modal fade" id="assignGuestModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Assign Guest to Table</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Search and Select Guest</label>
                    <!-- Value is now GuestId instead of Id -->
                    <select class="form-select" id="guestSelectDropdown">
                        <option value="">-- Loading... --</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnAssignGuestSave">Assign</button>
            </div>
        </div>
    </div>
</div>