@model EventDto

@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-4">
    <partial name="Partials/_EventHeader" model="Model" />
    <partial name="Partials/_TableButtons" model="Model.Tables" />
    <partial name="Partials/_GuestTable" />
    <input type="hidden" id="currentEventId" value="@Model.Id" />
</div>

<!-- Serialize Model Data to JSON for Client-Side Use -->
<script id="eventDataScript" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(@Model,
    new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))    
</script>

@section Scripts {
    <script>
        var eventData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(@Model));
        console.log("EventDto Complete Data: >>>", eventData);
    </script>

    <script src="~/js/event-detail.js"></script>
}